# Optional: enables "Giro AI" curation powered by Claude. Without it, Giro uses its built-in curation engine.
ANTHROPIC_API_KEY=

# Optional affiliate / partner IDs appended to outbound booking links (leave blank until you join each program).
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_EXPEDIA_AFFCID=
NEXT_PUBLIC_SKYSCANNER_ASSOCIATE_ID=
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
NEXT_PUBLIC_VIATOR_PID=

# Postgres for accounts, groups and click tracking (Neon, Supabase, RDS…). Without it, an embedded
# PGlite database is stored in .data/ (fine for development, not for serverless production).
DATABASE_URL=

# Comma-separated emails that can see /admin/revenue.
ADMIN_EMAILS=

# Open-Meteo is free for non-commercial use; set a key to use the commercial API for Giro Live forecasts.
OPEN_METEO_API_KEY=

# Transactional email (password reset, verification, invites) via Resend.
RESEND_API_KEY=
# After verifying your domain in Resend, e.g. "Giro <hello@yourdomain.com>".
EMAIL_FROM=
# Public site address used in email links (defaults to the Vercel production URL).
APP_URL=
# Shown on the Privacy, Terms and Affiliate Disclosure pages.
CONTACT_EMAIL=
