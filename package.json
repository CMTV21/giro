    "catalog:promote": "node --experimental-strip-types scripts/promote-destination.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@vercel/analytics": "2.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "postal-mime": "^2.7.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
