{
  "name": "giro",
  "version": "0.1.0",
  "private": true,
  "description": "Giro — curated trip planning with one-click booking across Google Flights, Airbnb, Booking.com, Expedia and more.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
